# Copie para .env.local e preencha. O .env.local é ignorado pelo git.
# Os mesmos valores precisam estar na Vercel: Project → Settings → Environment Variables.

# ── Público — vai para o browser ────────────────────────────────────────────
# Seguro por design: a anon key só consegue o que as policies de RLS permitirem.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Servidor apenas — NUNCA prefixar com NEXT_PUBLIC_ ───────────────────────
# O service role IGNORA todo o RLS. Só pode ser lido em Route Handlers,
# Server Actions e Server Components. Se vazar, a base inteira vaza junto.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Conexão direta com o Postgres — usada só por migrações e scripts locais.
POSTGRES_URL_NON_POOLING=
